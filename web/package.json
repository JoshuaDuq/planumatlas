{
  "name": "planum-web",
  "version": "0.1.2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && svelte-check --tsconfig ./tsconfig.test.json && node node_modules/typescript/bin/tsc -p tsconfig.node.json && node node_modules/typescript/bin/tsc -p tsconfig.sw.json",
    "check:ts7": "node node_modules/@typescript/native/bin/tsc -p tsconfig.ts7.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.test.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.node.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.sw.json",
    "lint": "oxlint",
    "format": "prettier .",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@niivue/niivue": "0.69.0",
    "bits-ui": "2.22.0",
    "driver.js": "1.10.2",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.1.1",
    "axe-core": "4.14.1",
    "meshoptimizer": "1.3.0",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-browser-svelte": "3.1.0"
  }
}
